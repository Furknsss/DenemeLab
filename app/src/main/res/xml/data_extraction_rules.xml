<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="sharedpref" path="denemelab_local_v1.xml"/>
        <include domain="file" path="publisher-logos/"/>
        <include domain="file" path="profile-pictures/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="denemelab_local_v1.xml"/>
        <include domain="file" path="publisher-logos/"/>
        <include domain="file" path="profile-pictures/"/>
    </device-transfer>
</data-extraction-rules>
